# Supabase Config (Frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Database Connection (Opcional - solo para scripts manuales en scripts/*.mjs)
# DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Resend API Key (Notificaciones de Inscripción y Pagos)
# RESEND_API_KEY=re_your_resend_api_key
# VITE_RESEND_API_KEY=re_your_resend_api_key
